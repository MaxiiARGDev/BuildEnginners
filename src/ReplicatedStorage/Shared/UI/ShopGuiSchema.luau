			end
		elseif type(v) == "string" then
			if k == "Font" then
				anyInst[k] = (Enum.Font :: any)[v]
			elseif k == "TextXAlignment" then
				anyInst[k] = (Enum.TextXAlignment :: any)[v]
			elseif k == "TextYAlignment" then
				anyInst[k] = (Enum.TextYAlignment :: any)[v]
			elseif k == "TextTruncate" then
				anyInst[k] = (Enum.TextTruncate :: any)[v]
			elseif k == "FillDirection" then
				anyInst[k] = (Enum.FillDirection :: any)[v]
			elseif k == "SortOrder" then
				anyInst[k] = (Enum.SortOrder :: any)[v]
			elseif k == "HorizontalAlignment" then
				anyInst[k] = (Enum.HorizontalAlignment :: any)[v]
			elseif k == "VerticalAlignment" then
				anyInst[k] = (Enum.VerticalAlignment :: any)[v]
			elseif k == "AutomaticSize" or k == "AutomaticCanvasSize" then
				anyInst[k] = (Enum.AutomaticSize :: any)[v]
			elseif k == "ScrollingDirection" then
				anyInst[k] = (Enum.ScrollingDirection :: any)[v]
			elseif k == "ZIndexBehavior" then
				anyInst[k] = (Enum.ZIndexBehavior :: any)[v]
			else
				anyInst[k] = v
			end
		else
			anyInst[k] = v
		end
	end
end

local function buildNode(name: string, node: { [string]: any }, parent: Instance): Instance
	local inst = Instance.new(node.className)
	inst.Name = name
	applyProperties(inst, node.properties)
	if type(node.children) == "table" then
		for _, childSpec in ipairs(node.children) do
			buildNode(childSpec.name, childSpec, inst)
		end
	end
	inst.Parent = parent
	return inst
end

function ShopGuiSchema.BuildScreenGui(targetParent: Instance?): ScreenGui
	local decoded = HttpService:JSONDecode(SCHEMA_JSON)
	local sg = Instance.new("ScreenGui")
	sg.Name = "ShopGui"
	applyProperties(sg, decoded.Meta and decoded.Meta.properties)

	local modelKeys = {}
	for k in pairs(decoded.Models) do
		table.insert(modelKeys, k)
	end
	table.sort(modelKeys)
	for _, k in ipairs(modelKeys) do
		buildNode(k, decoded.Models[k], sg)
	end

	if targetParent then
		sg.Parent = targetParent
	end
	return sg
end

function ShopGuiSchema.EnsureStarterGui(): ScreenGui
	local existing = StarterGui:FindFirstChild("ShopGui")
	if existing and existing:IsA("ScreenGui") then
		local mf = existing:FindFirstChild("MainFrame")
		if mf and mf:FindFirstChild("CrateFamilyFilterBar") and mf:FindFirstChild("EmptyCatalogOverlay") then
			return existing
		end
	end
	if existing then
		existing:Destroy()
	end
	return ShopGuiSchema.BuildScreenGui(StarterGui)
end

return ShopGuiSchema